{
    "experiment_name": "Restormer_v28Jun1500",
    "model_info": {
        "name": "3DUNET",
        "path": "pl_models/models/pixel_flow.py",
        "model_class": "PixelFlowModel",
        "modelType": "vol2vol",
        "possibleTypes": ["vol2vol", "3DPatch", "2DImage", "2.5DImage"],

        "pretrained": "True",
        "weight_path" : "models/3DSwin/weights.pth"
    },
    "model": {
        "num_attention_heads": 16, 
        "attention_head_dim": 72,
        "in_channels": 256,
        "out_channels": 256,
        "depth": 28,
        "num_classes": 1000,
        "patch_size": 4,
        "attention_bias": true
    },
    "checkpoint":{
        "save_frequency_epoch": 5,
        "save_topk": 3,
        "monitor": "val_loss",
        "dirpath": "checkpoints/",
        "filename": "{epoch}-{step}-{val_loss:.8f}"
    },
    "loss":{
        "MSE": {
        "params": {
            "weight": 1.0,
            "ignore_index": -1,
            "reduction": "mean"
            }
        },
        "SSIM": {
            "params": {
                "weight": 1.0,
                "ignore_index": -1,
                "reduction": "mean"
            }
        },
        "Perceptual": {
            "params": {
                "weight": 1.0,
                "ignore_index": -1,
                "reduction": "mean",
                "model": "vgg16",
                "layers": [0, 5, 10, 19, 28]
            }
        }
    },
    "training": {
        "mono_channel": false,
        "epochs": 1500,
        "batch_size": 1,
        "num_workers": 4,
        "learning_rate": 0.001,
        "optimizer": "adam",
        "scheduler": "SingleCycleCosine",
        "cosine_restart_after": 20,
        "loss_function": "cross_entropy"
    }
}