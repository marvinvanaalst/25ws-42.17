{
    "Project_Name": "Structural_MRI_Enhancement",
    "experiment_name": "2026_01_20_UNETR_32_trilinear",
    "model_info": {
        "name": "3DUNET",
        "path": "pl_models/models/MONAI/UNETR.py",
        "model_class": "fetch_UNETR",
        "modelType": "pre_computed_patch2patch",
        "possibleTypes": [
            "vol2vol",
            "patch2patch",
            "2DImage",
            "2.5DImage",
            "pre_computed_patch2patch",
            "pre_computed_slice2slice"
        ],
        "pretrained": "True"
    },
    "data": {
        "direction": {
            "source": "3T_7TReg",
            "target": "7T",
            "mask_dir_name": "MASK3T_7TReg"
        },
        "training": {
            "subjects_path": "/storage/an_inam/MR2MR/Data/10_Pat_t1",
            "subjects": [
                "sub-01_T1w.nii.gz",
                "sub-02_T1w.nii.gz",
                "sub-03_T1w.nii.gz",
                "sub-04_T1w.nii.gz",
                "sub-05_T1w.nii.gz",
                "sub-06_T1w.nii.gz",
                "sub-07_T1w.nii.gz",
                "sub-08_T1w.nii.gz",
                "sub-09_T1w.nii.gz",
                "sub-10_T1w.nii.gz"
            ]
        },
        "slice_axis": 2
    },
    "augmentations":{
        "apply" : false,
        "till": 80,
        "augmentation_prob": 0.9,
        "type": "dynamic",
        "available_types": ["static", "dynamic"]
    },
    "model": {
        "in_channels": 1,
        "out_channels": 1,
        "img_size": [64, 64, 64],
        "feature_size": 32,
        "hidden_size": 768,
