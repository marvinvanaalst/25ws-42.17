    "loss": {
        "types": [
            [
                "L1",
                1.0
            ]
        ],
        "available": [
            "L1",
            "L2",
            "SynthSeg",
            "lpips_alex_2d"
        ],
        "synth_seg_path": "pl_models/models/synthseg/synthseg_2.0_pytorch.pt"
    },
    "slicify":{
        "pad_boolean": true,
        "pad_to" : 608,
        "resize_to" : 512
    },
    "patchify":{
        "patch_size": 64,
        "patch_overlap": 8
    },
    "fine_tunning":{
        "pretrain_boolean": false,
        "pretrain_evaluate_only": false,
        "data_foldsvvv": 5,
        "pretrained_model_weight": ""
    }, 
    "training": {
        "mono_channel": false,
        "epochs": 300,
        "warmup_percentage_steps": 0.05, 
        "batch_size": 16,
        "num_workers": 4,
        "samples_per_sample": 7,
        "weight_decay": 1e-02,
        "learning_rate": 0.0002,
        "optimizer": "adam",
        "scheduler": "SingleCycleCosine",
        "cosine_restart_after": 20,
        "loss_function": "cross_entropy",
        "save_generation": true,
        "splits":{
            "validation_samples" :  0,
            "num_test_samples" : 1,
            "single_pass": false

        }
    },
    "patch_inference": {
