        "norm_name": "instance",
        "res_block": true,
        "dropout_rate": 0.0,
        "interpolation": "trilinear"
    },
    "checkpoint": {
        "save_dir": "./checkpoints",
        "monitor": "val_ssim",
        "mode": "max",
        "top_k": 0,
        "save_every_n_epochs": 300,
        "filename_template": "epoch={epoch:02d}-{monitor}={score:.4f}.pt"
